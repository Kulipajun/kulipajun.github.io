---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  copy?: string;
}

const { number, eyebrow, title, copy } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div class="section-index">{number}</div>
  <div class="section-heading-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
    {copy && <p class="section-description">{copy}</p>}
  </div>
</header>
