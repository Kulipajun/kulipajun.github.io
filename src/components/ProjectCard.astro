---
import type { ResearchProject } from "@data/site";

interface Props {
  project: ResearchProject;
}

const { project } = Astro.props;
---

<article class:list={["project", { "project-reversed": project.reversed }]} data-reveal>
  <div class="project-visual">
    <img src={project.image} alt={project.imageAlt} loading="lazy" />
    <span class="project-number">{project.number}</span>
  </div>

  <div class="project-copy">
    <div class="project-meta">
      <span>{project.eyebrow}</span>
      <span>{project.year}</span>
    </div>
    <h3>{project.title}</h3>
    <p>{project.summary}</p>
    <ul class="tag-list" aria-label="Project topics">
      {project.tags.map((tag) => <li>{tag}</li>)}
    </ul>
    <div class="project-links">
      {project.links.map((link) => (
        <a href={link.url} aria-disabled={link.url === "#"}>
          {link.label} <span>↗</span>
        </a>
      ))}
    </div>
  </div>
</article>
