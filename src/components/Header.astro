---
import { navigation, profile } from "@data/site";
---

<header class="site-header">
  <a class="wordmark" href="#top" aria-label={`${profile.name}, back to top`}>
    <span>{profile.shortName}</span>
    <span class="wordmark-name">{profile.name}</span>
  </a>

  <nav aria-label="Main navigation">
    <ul>
      {navigation.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>

  <a class="header-email" href={`mailto:${profile.email}`}>Email ↗</a>
</header>
