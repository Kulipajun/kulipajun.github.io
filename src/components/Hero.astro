---
import { profile } from "@data/site";
---

<section class="hero section-shell" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">HCI researcher · Tokyo / Aarhus</p>
    <h1 id="hero-title">{profile.headline}</h1>
    <p class="hero-introduction">{profile.introduction}</p>

    <div class="hero-actions">
      <a class="button button-primary" href="#research">Selected research</a>
      <a class="text-link" href={`mailto:${profile.email}`}>Start a conversation <span>↗</span></a>
    </div>
  </div>

  <div class="hero-portrait">
    <div class="portrait-frame">
      <img src={profile.portrait} alt={`Portrait of ${profile.name}`} />
      <span class="portrait-mark" aria-hidden="true">XR</span>
    </div>
    <p class="portrait-caption">
      Currently <strong>{profile.currentRole.title}</strong> at
      <a href={profile.currentRole.url}>{profile.currentRole.institution}</a>.
    </p>
  </div>

  <div class="hero-status" data-reveal>
    <span class="status-date">{profile.nextRole.date}</span>
    <p>
      Joining <a href={profile.nextRole.institutionUrl}>{profile.nextRole.institution}</a>
      as a PhD student, supervised by {profile.nextRole.supervisor}.
    </p>
  </div>
</section>
