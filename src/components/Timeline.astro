---
interface TimelineEntry {
  period: string;
  title: string;
  institution: string;
  detail: string;
  upcoming?: boolean;
}

interface Props {
  title: string;
  entries: TimelineEntry[];
}

const { title, entries } = Astro.props;
---

<section class="timeline-group" data-reveal>
  <h3>{title}</h3>
  <div class="timeline-list">
    {entries.map((entry) => (
      <article class="timeline-entry">
        <p class="timeline-period">{entry.period}</p>
        <div>
          <div class="timeline-title-line">
            <h4>{entry.title}</h4>
            {entry.upcoming && <span class="upcoming-label">Upcoming</span>}
          </div>
          <p class="timeline-institution">{entry.institution}</p>
          {entry.detail && <p class="timeline-detail">{entry.detail}</p>}
        </div>
      </article>
    ))}
  </div>
</section>
