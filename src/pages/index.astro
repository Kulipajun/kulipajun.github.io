---
import {
  education,
  experience,
  navigation,
  news,
  profile,
  publications,
  recognition,
  service,
} from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";

const primaryLink = (publication: { links: { url: string }[] }) =>
  publication.links[0]?.url;
---

<BaseLayout
  title={`${profile.name} — HCI, XR & Perception`}
  description="Yuan Li is an HCI researcher"
>
  <header class="site-nav">
    <a class="site-name" href="#top">{profile.name}</a>
    <nav aria-label="Main navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </header>

  <main id="top" class="container">
    <section class="intro">
      <img class="portrait" src={profile.portrait} alt={`Portrait of ${profile.name}`} />
      <div class="intro-copy">
        <h1>{profile.name}</h1>

        <p class="role">
          {profile.currentRole.title} at{" "}
          <a href={profile.currentRole.url}>{profile.currentRole.institution}</a>
        </p>

        {profile.introduction.map((paragraph) => (
  <p set:html={paragraph} />
))}

        <div class="profile-links">
          {profile.links.map((link) => <a href={link.url}>{link.label}</a>)}
        </div>
      </div>
    </section>

    <section id="news">
      <h2>News</h2>
      <ul class="news-list">
        {news.map((item) => (
          <li>
            <time>{item.year}</time>
            <span>{item.text}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="research">
      <h2>Selected Publications</h2>
      <div class="research-list">
        {publications.map((publication) => (
          <article class="research-item">
            {primaryLink(publication) ? (
              <a href={primaryLink(publication)} aria-label={`Open ${publication.title}`}>
                <img src={publication.image} alt={publication.imageAlt} loading="lazy" />
              </a>
            ) : (
              <img src={publication.image} alt={publication.imageAlt} loading="lazy" />
            )}

            <div>
              <div class="publication-heading">
                <h3>
                  {primaryLink(publication) ? (
                    <a href={primaryLink(publication)}>{publication.title}</a>
                  ) : (
                    publication.title
                  )}
                </h3>

                {publication.award && (
                  <span class="award-badge" title={publication.award}>
                    <span aria-hidden="true">★</span> {publication.award}
                  </span>
                )}
              </div>

              <p class="authors">
                {publication.authors.map((author, index) => (
                  <>
                    {author.url ? (
                      <a href={author.url}>
                        {author.self ? <strong>{author.name}</strong> : author.name}
                      </a>
                    ) : author.self ? (
                      <strong>{author.name}</strong>
                    ) : (
                      author.name
                    )}

                    {author.equal && <sup>*</sup>}
                    {index < publication.authors.length - 1 ? ", " : ""}
                  </>
                ))}
              </p>

              <p class="meta">
                <em>{publication.venue}</em>, {publication.year}
              </p>

              <p>{publication.summary}</p>

              {(publication.links.length > 0 || publication.status) && (
                <p class="item-links">
                  {publication.links.map((link) => <a href={link.url}>{link.label}</a>)}
                  {publication.status && <span>{publication.status}</span>}
                </p>
              )}

              {publication.authors.some((author) => author.equal) && (
                <p class="equal-note">
                  <sup>*</sup> Equal contribution
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
      <div class="section-action">
        <a class="text-button" href="/publications/">All Publications</a>
      </div>
    </section>

    <section id="education">
      <h2>Education</h2>
      <div class="entry-list">
        {education.map((item) => (
          <article class="entry">
            <div>
              <h4>{item.title}</h4>
              <p class="affiliation" set:html={item.institution} />
              {item.detail && <p class="detail" set:html={item.detail} />}
              {"details" in item && item.details && item.details.map((detail) => (
                <p class="detail" set:html={detail} />
              ))}
            </div>
            <time>{item.period}</time>
          </article>
        ))}
      </div>
    </section>

    <section id="experience">
      <h2>Experience</h2>
      <div class="entry-list">
        {experience.map((item) => (
          <article class="entry">
            <div>
              <h4>{item.title}</h4>
              <p class="affiliation" set:html={item.institution} />
              {item.detail && <p class="detail" set:html={item.detail} />}
              {"collaborators" in item && item.collaborators && (
                <p class="detail collaborators">
                  Main collaborators:{" "}
                  {item.collaborators.map((person, index) => (
                    <>
                      <a href={person.url}>{person.name}</a>
                      {index < item.collaborators.length - 1 && ", "}
                    </>
                  ))}
                </p>
              )}
            </div>
            <time>{item.period}</time>
          </article>
        ))}
      </div>
    </section>

    <section id="awards">
      <h2>Awards & Funding</h2>
      <ul class="simple-list">
        {recognition.map((item) => (
          <li>
            <span>
              <strong>{item.title}</strong>, {item.institution}
            </span>
            <time>{item.year}</time>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Academic Service</h2>
      <ul class="simple-list">
        {service.map((item) => (
          <li>
            <span>
              <strong>{item.title}</strong>, {item.institution}
            </span>
            <time>{item.year}</time>
          </li>
        ))}
      </ul>
    </section>

    <section class="secret-link-section" aria-label="Secret Base">
      <a class="secret-link" href="/secret-base/">Secret Base</a>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} {profile.name}</p>
  </footer>
</BaseLayout>




















