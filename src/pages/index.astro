---
import {
  education,
  experience,
  navigation,
  news,
  profile,
  recognition,
  researchProjects,
  service,
} from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${profile.name} — HCI, XR & Perception`}
  description="Yuan Li is an HCI researcher exploring extended reality and human perception."
>
  <header class="site-nav">
    <a class="site-name" href="#top">{profile.name}</a>
    <nav aria-label="Main navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </header>

  <main id="top" class="container">
    <section class="intro">
      <img class="portrait" src={profile.portrait} alt={`Portrait of ${profile.name}`} />
      <div class="intro-copy">
        <h1>{profile.name}</h1>
        <p class="role">
          Technical Assistant at <a href={profile.currentRole.url}>The University of Tokyo</a>
        </p>
        <p>
          I am an HCI researcher interested in <strong>extended reality</strong> and
          <strong>human perception</strong>. I explore how immersive technologies shape
          the way people perceive, understand, and interact with digital and physical
          environments.
        </p>
        <p>
          In <strong>August 2026</strong>, I will join
          <a href={profile.nextRole.institutionUrl}>Aarhus University</a> as a PhD
          student under the supervision of <strong>{profile.nextRole.supervisor}</strong>.
        </p>
        <div class="profile-links">
          {profile.links.map((link) => <a href={link.url}>{link.label}</a>)}
        </div>
      </div>
    </section>

    <section id="news">
      <h2>News</h2>
      <ul class="news-list">
        {news.map((item) => (
          <li><time>{item.year}</time><span>{item.text}</span></li>
        ))}
      </ul>
    </section>

    <section id="research">
      <h2>Selected Research</h2>
      <p class="section-note">
        Placeholder projects for the first content pass. Images, titles, and links can
        be replaced in <code>src/data/site.ts</code>.
      </p>
      <div class="research-list">
        {researchProjects.map((project) => (
          <article class="research-item">
            <img src={project.image} alt={project.imageAlt} loading="lazy" />
            <div>
              <h3>{project.title}</h3>
              <p class="meta">{project.eyebrow} · {project.year}</p>
              <p>{project.summary}</p>
              <p class="item-links">
                {project.links.map((link) => <a href={link.url}>{link.label}</a>)}
              </p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="experience">
      <h2>Experience</h2>
      <div class="subsection">
        <h3>Education</h3>
        <div class="entry-list">
          {education.map((item) => (
            <article class="entry">
              <div>
                <h4>{item.title}</h4>
                <p>{item.institution}</p>
                <p class="detail">{item.detail}</p>
              </div>
              <time>{item.period}</time>
            </article>
          ))}
        </div>
      </div>

      <div class="subsection">
        <h3>Research & Industry</h3>
        <div class="entry-list">
          {experience.map((item) => (
            <article class="entry">
              <div>
                <h4>{item.title}</h4>
                <p>{item.institution}</p>
                {item.detail && <p class="detail">{item.detail}</p>}
              </div>
              <time>{item.period}</time>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="awards">
      <h2>Awards & Funding</h2>
      <ul class="simple-list">
        {recognition.map((item) => (
          <li>
            <span><strong>{item.title}</strong>, {item.institution}</span>
            <time>{item.year}</time>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Academic Service</h2>
      <ul class="simple-list">
        {service.map((item) => (
          <li>
            <span><strong>{item.title}</strong>, {item.institution}</span>
            <time>{item.year}</time>
          </li>
        ))}
      </ul>
    </section>

    <section id="contact">
      <h2>Contact</h2>
      <p>
        Email: <a href={`mailto:${profile.email}`}>{profile.email}</a><br />
        Location: {profile.location}
      </p>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} {profile.name}</p>
  </footer>
</BaseLayout>
