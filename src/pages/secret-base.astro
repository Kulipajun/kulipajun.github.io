---
import { navigation, profile } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Secret Base — ${profile.name}`}
  description="A small corner for Yuan Li's interests and hobbies"
>
  <header class="site-nav">
    <a class="site-name" href="/">{profile.name}</a>
    <nav aria-label="Main navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </header>

  <main class="container secret-page">
    <section class="page-intro">
      <h1>Secret Base</h1>
      <p>
        Under construction :D This will become a small corner for hobbies,
        side quests, tiny obsessions, and things I like outside research.
        🎮 🎧 📷 ✈️
      </p>
    </section>

    <section class="under-construction-card">
      <p class="construction-mark">:D</p>
      <h2>Under construction</h2>
      <p>
        I am still building this little hideout. Come back later for notes on
        games, music, travel, photos, and whatever else quietly survives peer
        review.
      </p>
    </section>
  </main>

  <footer>
    <p>© {new Date().getFullYear()} {profile.name}</p>
  </footer>
</BaseLayout>
